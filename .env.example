# DATABASE_URL / MYSQL_URL: Connection string for any MySQL / MariaDB server.
# Set DB_SSL=true when the server requires TLS. Set DB_SSL_REJECT_UNAUTHORIZED=true
# when a trusted CA is available; leave it false only when the server uses a private CA.
DATABASE_URL="mysql://root:password@127.0.0.1:3306/app"
MYSQL_URL="mysql://root:password@127.0.0.1:3306/app"
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=false

# GEMINI_API_KEY: Legacy (optional) — kept as fallback.
# GEMINI_API_KEY: Required for Gemini AI API calls.

GEMINI_API_KEY="MY_GEMINI_API_KEY"
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=

# OPENROUTER (preferred) — free route
# Get key at https://openrouter.ai/keys → set OPENROUTER_API_KEY. Free model: openrouter/free
OPENROUTER_API_KEY=
OPENROUTER_API_KEY_2=
OPENROUTER_API_KEY_3=
OPENROUTER_MODEL="openrouter/free"

# APP_URL: The URL where this applet is hosted.

# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
VITE_APP_URL="MY_APP_URL"

# Optional secret for a hosting scheduler calling /api/jobs/daily-credit.
DAILY_CREDIT_JOB_SECRET=

# PAYMENT GATEWAY CONFIGURATION (mobile-money provider)
PAYMENT_GATEWAY_URL="https://zulupay.org"
PAYMENT_PUBLIC_KEY= 
PAYMENT_SECRET_KEY=
PAYMENT_WEBHOOK_URL=
PAYMENT_WITHDRAW_PASSWORD=
ADMIN_PHONE=, 
ADMIN_PASSWORD=, 
ADMIN_USERNAME=
